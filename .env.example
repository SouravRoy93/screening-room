# ============================================================================
#  Screening Room — environment variables (copy to .env for local dev).
#  In production these are set in the Render dashboard, NOT committed.
# ============================================================================

# ---------- Frontend (static site) — VITE_ vars are baked in at build ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key   # safe to expose (RLS-protected)
VITE_API_URL=https://YOUR-API.onrender.com/api                 # your API service URL + /api
BASE_PATH=/

# ---------- API (Express web service) ----------
GOOGLE_PLACES_API_KEY=your-google-places-key   # SECRET — restrict by API + HTTP referrer in GCP
TMDB_KEY=your-tmdb-api-key                      # SECRET
ALLOWED_ORIGINS=https://YOUR-FRONTEND.onrender.com   # comma-separated CORS allowlist
DATABASE_URL=postgres://...                     # optional: Supabase Postgres, only if API uses DB

# ---------- GitHub Actions (daily catalog-grow crons) — set as repo Secrets ----------
# GOOGLE_PLACES_API_KEY, ANTHROPIC_API_KEY, TMDB_KEY
